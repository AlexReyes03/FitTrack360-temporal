DATABASE_URL=postgresql://fittrack:fittrack@localhost:5432/fittrack
PORT=3000

# Firebase Auth: admin | mock. Solo project_id, client_email y private_key del JSON.
FIREBASE_AUTH_MODE=admin
FIREBASE_PROJECT_ID=fittrack360-98c44
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@fittrack360-98c44.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_APPLICATION_CREDENTIALS=E:/ruta/al/serviceAccount.json

# Mailpit: 127.0.0.1 en host, mailpit en Docker.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@fittrack360.local

UPLOAD_DIR=./uploads

# USDA FoodData Central. Solo la lee el API (proxy GET /api/v1/foods/search).
# Sin valor, o si USDA no responde en 5 s, el endpoint responde 503
# USDA_UNAVAILABLE y Flutter abre captura manual. No pegues una key real.
USDA_FDC_API_KEY=
