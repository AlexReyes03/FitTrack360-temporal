DATABASE_URL=postgresql://fittrack:fittrack@localhost:5432/fittrack
PORT=3000
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Correo local (Mailpit, sin TLS). Dentro de docker compose el API usa el
# servicio mailpit. Si el API corre en el host (pnpm start), ese nombre no
# resuelve: usa 127.0.0.1 contra el puerto publicado 1025. El servicio api
# del compose fuerza SMTP_HOST=mailpit aunque este archivo diga otra cosa.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@fittrack360.local

# Almacenamiento local de archivos (relativo a fit_track_api).
UPLOAD_DIR=./uploads
