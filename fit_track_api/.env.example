DATABASE_URL=postgresql://fittrack:fittrack@localhost:5432/fittrack
# Puerto del API (único default de desarrollo: 3000). Debe ser un entero entre
# 1 y 65535; si no, el API no arranca y lo explica en consola.
# - Nest nativo (pnpm start:dev): http://localhost:3000
# - Docker (panel pnpm dev): publica el mismo puerto, -p PORT:PORT
# - Emulador Android: http://10.0.2.2:3000, el default de Flutter
# - Teléfono físico: el panel aplica adb reverse tcp:PORT y usa localhost
# Si cambias PORT, pasa a Flutter --dart-define=API_BASE_URL=http://<host>:<PORT>.
PORT=3000
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Correo local (Mailpit). Mailpit aun no esta en docker-compose; si SMTP_HOST
# falta o el puerto no responde, forgot sigue respondiendo 200 sin enviar.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@fittrack360.local

# Almacenamiento local de archivos (relativo a fit_track_api).
UPLOAD_DIR=./uploads
