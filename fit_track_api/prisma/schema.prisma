generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(uuid())
  /// UID de Firebase Auth. Obligatorio para cuentas nuevas (AUTH-01).
  firebaseUid          String?             @unique
  email                String              @unique
  username             String              @unique
  /// En desuso tras Firebase Auth; se conserva nullable por wipe 2A.
  passwordHash         String?
  displayName          String
  privacyConsentAt     DateTime
  privacyNoticeVersion String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  refreshTokens        RefreshToken[]
  passwordResetCodes   PasswordResetCode[]
  workoutSessions      WorkoutSession[]
  routines             Routine[]
  photos               Photo[]
  bodyMetrics          BodyMetric[]
  mealLogs             MealLog[]
  settings             UserSettings?
}

enum WeightUnit {
  kg
  lb
}

enum DistanceUnit {
  km
  mi
}

/// Metas nutricionales y preferencias del deportista (relación 1:1 con User).
/// Se crea de forma perezosa en el primer PATCH /users/me; mientras no exista,
/// el API responde los valores por defecto declarados aquí.
model UserSettings {
  userId               String       @id
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCalorieGoal     Int          @default(2000)
  proteinGoalG         Int          @default(150)
  carbsGoalG           Int          @default(250)
  fatGoalG             Int          @default(65)
  weightUnit           WeightUnit   @default(kg)
  distanceUnit         DistanceUnit @default(km)
  restSeconds          Int          @default(90)
  notificationsEnabled Boolean      @default(false)
  biometricEnabled     Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
}

model PasswordResetCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
}

model Exercise {
  id                 String            @id
  name               String
  nameEs             String?
  category           String?
  bodyPart           String
  equipment          String
  target             String
  muscleGroup        String?
  secondaryMuscles   String[]          @default([])
  level              String?
  instructionsEs     String?
  instructionStepsEs String[]          @default([])
  commonErrors       String?
  imageFile          String
  gifFile            String
  mediaId            String?
  attribution        String
  workoutSets        WorkoutSet[]
  routineExercises   RoutineExercise[]
}

model Routine {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  exercises RoutineExercise[]
  sessions  WorkoutSession[]

  @@index([userId])
}

model RoutineExercise {
  id         String   @id @default(uuid())
  routineId  String
  routine    Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  position   Int
  targetSets Int
  targetReps Int

  @@unique([routineId, position])

  @@index([bodyPart])
  @@index([equipment])
  @@index([target])
}

model WorkoutSession {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId String?
  routine   Routine?     @relation(fields: [routineId], references: [id], onDelete: SetNull)
  startedAt DateTime
  endedAt   DateTime?
  location  String?
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  sets      WorkoutSet[]
}

model WorkoutSet {
  id         String         @id @default(uuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order      Int
  weight     Float
  reps       Int
  rpe        Float?
  rir        Int?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model BodyMetric {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  measuredAt     DateTime
  weightKg       Float?
  bodyFatPercent Float?
  waistCm        Float?
  photos         Photo[]

  @@index([userId])
}

model Photo {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey String
  mimeType   String
  sizeBytes  Int
  width      Int
  height     Int
  mealId     String?
  meal       MealLog?    @relation(fields: [mealId], references: [id], onDelete: SetNull)
  metricId   String?
  metric     BodyMetric? @relation(fields: [metricId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([userId])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model MealLog {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  eatenAt   DateTime
  mealType  MealType
  notes     String?
  photoId   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     MealItem[]
  photos    Photo[]
}

model MealItem {
  id        String   @id @default(uuid())
  mealLogId String
  mealLog   MealLog  @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  fdcId     String?
  name      String
  servingG  Float
  kcal      Float
  proteinG  Float
  carbsG    Float
  fatG      Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
