generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Nota: 'docs/plans/plan-maestro-fittrack360.md' (Sección 1.3 / 2) no especifica mapeos
// @map ni @@map en snake_case para las tablas de autenticación; se utilizan los identificadores estándar.
model User {
  id                   String              @id @default(uuid())
  email                String              @unique
  username             String              @unique
  passwordHash         String
  displayName          String
  privacyConsentAt     DateTime
  privacyNoticeVersion String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  refreshTokens        RefreshToken[]
  passwordResetCodes   PasswordResetCode[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
}

model PasswordResetCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
}

model Exercise {
  id                 String   @id
  name               String
  bodyPart           String
  equipment          String
  target             String
  muscleGroup        String
  secondaryMuscles   String[]
  instructionsEs     String
  instructionStepsEs String[]
  imageFile          String
  gifFile            String
  attribution        String
}
