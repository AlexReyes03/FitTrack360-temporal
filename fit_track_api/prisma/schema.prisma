generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(uuid())
  email                String              @unique
  username             String              @unique
  passwordHash         String
  displayName          String
  privacyConsentAt     DateTime
  privacyNoticeVersion String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  refreshTokens        RefreshToken[]
  passwordResetCodes   PasswordResetCode[]
  workoutSessions      WorkoutSession[]
  mealLogs             MealLog[]
  settings             UserSettings?
}

enum WeightUnit {
  kg
  lb
}

enum DistanceUnit {
  km
  mi
}

/// Metas nutricionales y preferencias del deportista (relación 1:1 con User).
/// Se crea de forma perezosa en el primer PATCH /users/me; mientras no exista,
/// el API responde los valores por defecto declarados aquí.
model UserSettings {
  userId               String       @id
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCalorieGoal     Int          @default(2000)
  proteinGoalG         Int          @default(150)
  carbsGoalG           Int          @default(250)
  fatGoalG             Int          @default(65)
  weightUnit           WeightUnit   @default(kg)
  distanceUnit         DistanceUnit @default(km)
  restSeconds          Int          @default(90)
  notificationsEnabled Boolean      @default(false)
  biometricEnabled     Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
}

model PasswordResetCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
}

model Exercise {
  id          String @id
  name        String
  imageFile   String
  gifFile     String
  attribution String
  bodyPart    String
  equipment   String
  target      String
}

model WorkoutSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model MealLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eatenAt   DateTime
  mealType  MealType
  notes     String?
  photoId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
