generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(uuid())
  email                String              @unique
  username             String              @unique
  passwordHash         String
  displayName          String
  privacyConsentAt     DateTime
  privacyNoticeVersion String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  refreshTokens        RefreshToken[]
  passwordResetCodes   PasswordResetCode[]
  workoutSessions      WorkoutSession[]
  mealLogs             MealLog[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
}

model PasswordResetCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
}

model Exercise {
  id                 String       @id
  name               String
  nameEs             String?
  category           String?
  bodyPart           String
  equipment          String
  target             String
  muscleGroup        String?
  secondaryMuscles   String[]     @default([])
  level              String?
  instructionsEs     String?
  instructionStepsEs String[]     @default([])
  commonErrors       String?
  imageFile          String
  gifFile            String
  mediaId            String?
  attribution        String
  workoutSets        WorkoutSet[]
}

model WorkoutSession {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?
  location  String?
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  sets      WorkoutSet[]
}

model WorkoutSet {
  id         String         @id @default(uuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order      Int
  weight     Float
  reps       Int
  rpe        Float?
  rir        Int?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model MealLog {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  eatenAt   DateTime
  mealType  MealType
  notes     String?
  photoId   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     MealItem[]
}

model MealItem {
  id        String   @id @default(uuid())
  mealLogId String
  mealLog   MealLog  @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  fdcId     String?
  name      String
  servingG  Float
  kcal      Float
  proteinG  Float
  carbsG    Float
  fatG      Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
